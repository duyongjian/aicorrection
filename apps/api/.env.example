# =====================================================================
# aicorrection-v0.1 后端环境变量样例
# 复制为 apps/api/.env 后按需修改。所有项均有代码内默认值，未配置即回落默认。
# 注意：本文件可被提交（非敏感）；真实 .env 已被 .gitignore 忽略。
# =====================================================================

# ===== AI Provider 配置契约（§7.5）=====
# ---- 识别 / 视觉端：题目识别 + OCR 降级 ----
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1      # 默认 Ollama；可改为 MiniCPM-V-4.5 / 其它 OpenAI 兼容端点
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:0.5b
VISION_MODEL=llama3.2-vision
# 无 Mock 策略（产品硬约束）：真实模型失败必须如实返回失败，绝不用假数据凑数。
AUTO_FALLBACK_TO_MOCK=false

# ---- 分析 / 归因端：独立本地强模型（与"识别/视觉"分家）----
# 三者均默认回落上面的 LLM_*，未配置时分析与识别指向同一端点、同一模型（向后兼容）。
# ANALYSIS_BASE_URL=http://localhost:8085/v1
# ANALYSIS_MODEL=Qwen3.8-27B-Uncensored
# ANALYSIS_API_KEY=llama

# 是否关闭思考链（thinking）。默认 true（本地小显存强模型下显著提升速度、保住诊断力）。
DISABLE_THINKING=true

# ---- 超时预算（ms）----
ATTRIBUTION_TIMEOUT_MS=300000   # 归因（强模型 ~60~161s，留 ≥1.8x）
FOLLOWUP_TIMEOUT_MS=180000      # 追问（同强模型，留 ~1.1x）
OCR_TIMEOUT_MS=30000            # OCR 视觉模型

# ---- 本地 OCR（Python 子进程，纯 CPU，非视觉大模型）----
OCR_MODE=auto                   # auto=优先本地失败降级视觉 | local=只用本地 | llm=只用视觉大模型
OCR_TEXT_ENGINE=rapid           # rapid | paddle | tesseract（rapid 实测 ~2.4s，最佳）
OCR_FORMULA_AUTO=true           # 命数学信号时自动跑 Paddle 公式识别（~1.3s）
OCR_PYTHON=D:/AllSideProject/AICorrection/.venv-ocr/Scripts/python.exe
OCR_LOCAL_TIMEOUT_MS=60000      # 本地 OCR 子进程超时（Paddle 冷启可能 17s+）

# ---- 识别端（视觉大模型）按需拉起 ----
RECOGNITION_AUTOSTART=false
# RECOGNITION_START_CMD=...     # 拉起识别端实例的完整命令行（detached）
RECOGNITION_STARTUP_TIMEOUT_MS=120000
RECOGNITION_IDLE_SHUTDOWN_MS=600000

# ===== 题库 RAG（P1）=====
# 默认开启：确定性离线 hash 嵌入 + 纯 SQLite 余弦，零模型下载、零原生依赖。
RAG_ENABLED=true
RAG_TOP_K=4                      # 每次检索返回候选条数
RAG_MIN_SCORE=0.0                # 余弦相似度最低阈值（0 = 全保留；语义模型可调 0.2~0.3）
RAG_EMBED_MODEL=local-hash       # local-hash（默认）| bge（预留 TODO）
RAG_TIMEOUT_MS=8000              # 归因时 RAG 检索独立超时；超时即跳过参考块，不拖垮归因

# 升级语义更强嵌入（bge 等）——可选，非必需：
#   1) 安装 @xenova/transformers（npm i -D @xenova/transformers），在
#      embeddingService.embed 的 'bge' 分支实现本地推理；
#   2) 或改为调用远程 embedding 服务（HTTP），保持 embed() 同步/异步契约；
#   3) 升级后把 RAG_EMBED_MODEL=bge，并重跑 rag:import / rag:index 重建索引。
# 升级向量检索（sqlite-vec / lancedb）——可选：
#   当前用 embedding_vec(TEXT, JSON 数组) + Node 侧余弦，种子级数据量完全够用；
#   若题库扩展到数万级，可改为 sqlite-vec 原生向量索引或 lancedb，但会引入原生编译依赖，
#   故默认不启用（保持零原生依赖目标）。

# ===== 联网搜索（P2，默认关闭）=====
# 数据主权铁律硬约束：默认 false —— 绝不把用户内容（题干/作答）外发到第三方搜索引擎。
# 仅当用户显式开启 WEB_SEARCH_ENABLED=true，且只外发"脱敏后的主题词"（学科 + 知识点，
# 绝不含学生作答 / 姓名 / 手机号 / 邮箱），审计日志仅落本地 data/websearch_audit.log。
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=engine-html     # engine-html（默认，无需 key，抓 Bing/DuckDuckGo 等搜索页）| searxng（自托管，更稳）
WEB_SEARCH_ENGINE=bing             # engine-html 模式下的引擎：bing | duckduckgo | baidu | google
# WEB_SEARCH_SEARXNG_URL=http://localhost:8082/search   # provider=searxng 时填实例地址（需开启 json 输出）
WEB_SEARCH_MAX_RESULTS=5            # 返回条数
WEB_SEARCH_TIMEOUT_MS=6000         # 单次检索超时（对外网络，留比 RAG 更紧余量）
WEB_SEARCH_AUDIT=true              # 是否写本地审计日志（仅本地，不离开本机）

# ===== Server =====
PORT=3001
NODE_ENV=development
API_BASE_PATH=/api/v1

# 可选：覆盖 SQLite 数据库路径（默认 apps/api/data/aicorrection.db）
# DB_PATH=../data/aicorrection.db
