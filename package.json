{
  "name": "aicorrection-v0.1",
  "version": "0.1.0",
  "private": true,
  "description": "错题强化闭环 v0.1 monorepo (R01+R02+R03 + Infra-0)",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "build:shared": "npm run build -w @aicorrection/shared",
    "dev": "npm run build:shared && concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w @aicorrection/web",
    "dev:api": "npm run dev -w @aicorrection/api",
    "build": "npm run build:shared && npm run build -w @aicorrection/web && npm run build -w @aicorrection/api",
    "start:api": "npm run build:shared && npm run start -w @aicorrection/api",
    "start:test": "node scripts/start-test.mjs",
    "start:test:sh": "bash scripts/start-test.sh",
    "smoke": "npm run build:shared && tsx apps/api/src/tests/e2e-smoke.mjs",
    "prompt:ab": "npm run build:shared && tsx apps/api/src/tests/prompt-ab.mjs",
    "blind:export": "tsx apps/api/src/tests/blind-review.mjs export",
    "blind:score": "tsx apps/api/src/tests/blind-review.mjs score",
    "auto-eval": "tsx apps/api/src/tests/auto-eval.mjs",
    "attrib:anchors:test": "tsx --test apps/api/src/services/attribution/references.test.ts",
    "attrib:regress:real": "tsx scripts/attrib-regress.mjs",
    "attrib:regress": "npm run attrib:anchors:test",
    "license:generate": "tsx scripts/license-cli.mjs generate",
    "license:list": "tsx scripts/license-cli.mjs list",
    "license:revoke": "tsx scripts/license-cli.mjs revoke",
    "distribute": "node scripts/distribute.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.31.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.65.0"
  }
}
