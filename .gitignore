# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Local data (SQLite + uploads) — never commit
# 注意：运行时 DATA_DIR 由 env.ts 解析为 apps/api/src/data/（__dirname/../data，tsx 直接跑 src）
# 故此处需同时覆盖 src/data 与（构建后）data 两种路径。
apps/api/src/data/
apps/api/data/
apps/api/.env

# Env files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
.DS_Store

# Next.js (if any adjacent project)
.next/

# K1.3 Prompt A/B 报告（本地产物，不入库；需要归档时手动复制到 docs/）
reports/

# 线下分发产物（独立库 / uploads / 明文卡密 CSV）—— 绝不入库
# data/distribution/ 覆盖分发库 aicorrection-dist.db、uploads/ 及其中的 CSV；
# 根目录 *.csv 覆盖默认 --out 落点；*.cards.csv / *.license.csv 覆盖约定命名的输出。
# 注意：不要用全局 *.csv —— apps/api/scripts/mmulu_zh.csv 是题库数据，需保留在版本控制内。
data/distribution/
/*.csv
*.cards.csv
*.license.csv

# 杂项临时产物（端口探测重定向残留、误建空文件等，非源码）
8094
nul
.bak
scripts/start-dev.log*
