# ===== AI Provider 配置契约（§7.5）=====
# ollama | mock | openai(任意 OpenAI 兼容端点)
LLM_PROVIDER=ollama

# Ollama OpenAI 兼容端点（视觉 + 文本共用 base_url）
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# 归因/追问主模型（默认 qwen2.5:0.5b：本机已拉取、非 thinking、兼容 OpenAI content）
# 注意：qwen3 系列为 thinking 模型，OpenAI 兼容层下 content 为空且极慢，不建议直接用作归因模型；
# 生产/真实验证建议切云模型（仅改 BASE_URL/API_KEY/MODEL），如 MiniMax/DeepSeek/OpenAI。
LLM_MODEL=qwen2.5:0.5b
# OCR 视觉模型（待确认默认值）
VISION_MODEL=llama3.2-vision

# ===== 分析/归因 专用模型（与"识别/视觉"分家，可选）=====
# 背景：本地 MiniCPM-V-4.5 做视觉识别够用，但做"归因分析"会臆造错因；
# 题目识别/OCR 仍走上面的 LLM_* / VISION_*，而归因与追问可指向另一个更强的本地大模型
#（例如另起一个 llama.cpp 实例跑更大的 Qwen，监听在别的端口）。
# 三者均默认回落 LLM_*：不配置即与分家前行为完全一致。
# 注意：ANALYSIS_MODEL 必须填 llama.cpp 的**服务名**（server 启动时注册的
# model 名），不是 gguf 文件名；填错会 404/空返回。
# 当前已部署的分析强模型（RTX 4060 Laptop 8GB 显存，Qwen3.8-27B）：
ANALYSIS_BASE_URL=http://localhost:8085/v1
ANALYSIS_MODEL=Qwen3.8-27B-Uncensored
ANALYSIS_API_KEY=llama

# 是否关闭模型思考链（thinking）。默认 true。
# 该强模型权重 8.2GB > 显存 8188MiB，层溢出 CPU，生成仅 ~3 tok/s：
#   thinking 开 = 266s；thinking 关 = 161s（采用）。
# 严禁改用"收紧 prompt 禁止推导"来提速 —— 实测该变体虽 62s 但会误判错因，已否决。
DISABLE_THINKING=true

# Ollama 探活失败 → 自动降级 Mock，保证无模型也能跑通五步闭环 + 埋点
AUTO_FALLBACK_TO_MOCK=true

# 调用超时（毫秒）。按分析强模型 Qwen3.8-27B @ RTX4060 8GB（~3 tok/s，
# thinking 关闭后单次归因实测 161s）标定：300s 留约 1.8x 余量。
# 前端 axios 超时（apps/web/src/api/client.ts 的 REQUEST_TIMEOUT_MS）必须 >= 此值。
ATTRIBUTION_TIMEOUT_MS=300000
FOLLOWUP_TIMEOUT_MS=180000

# ===== 本地 OCR（纯 CPU，Python 子进程，非视觉大模型）=====
# auto=优先本地、失败降级视觉大模型；local=只用本地（失败即 fail）；llm=只用视觉大模型
OCR_MODE=auto
# 文本引擎：rapid（RapidOCR ~2.4s，推荐）；勿用 paddle 做文本（~17s）
OCR_TEXT_ENGINE=rapid
# 命中数学信号时自动跑一次 Paddle 公式识别（PP-FormulaNet-S，~1.3s）
OCR_FORMULA_AUTO=true
# 装有 rapidocr/paddleocr/pytesseract 的 venv 解释器
OCR_PYTHON=D:/AllSideProject/AICorrection/.venv-ocr/Scripts/python.exe
# OCR CLI（默认 apps/api/scripts/ocr/ocr_cli.py，一般无需改）
# OCR_CLI=
# 本地 OCR 子进程超时（Paddle 冷启可能 17s+，故比 OCR_TIMEOUT_MS 宽松）
OCR_LOCAL_TIMEOUT_MS=60000
OCR_TIMEOUT_MS=30000

# ===== Server =====
PORT=3001
NODE_ENV=development

# 前端埋点/接口请求前缀由 Vite 代理处理；API 自身根路径
API_BASE_PATH=/api/v1

# ===== 灰度 / 金丝雀发布（K1.4）=====
# 安全红线：默认 off → 100% control，默认 off 下不发 rollout_exposure、
# analytics_events 零新增（运行期现有行为完全不变）。
# 生效时机：除 ROLLOUT_KILL_SWITCH 外，以下变量由 env.ts 在模块加载时一次性快照，
# 改动需重启 API；kill-switch 由 getRolloutConfig() 动态读 process.env，
# 运行时置 1 即时熔断、无需重启。
# 策略：off（默认）| percentage | cohort
ROLLOUT_STRATEGY=off
# percentage 策略下的放量比例 0-100；默认 0（即不开）
ROLLOUT_PCT=0
# cohort 策略下的显式白名单（逗号分隔的 anon_user_id）；默认空
ROLLOUT_COHORT_ALLOWLIST=
# 紧急熔断：'1'/'true' → 立即 100% 回退 control（最高优先级、运行时即时生效）
ROLLOUT_KILL_SWITCH=false
# 示例 treatment 功能开关：新的「分步追问式讲解」风格；默认关闭，仅 treatment 组可见
ROLLOUT_FEAT_NEW_EXPLAIN=false

# ===== 数据主权 / 对外联网（默认关闭，P0 铁律）=====
# 绝不外发用户内容到第三方搜索引擎。脱敏 ≠ 授权：题干本身即用户内容。
# 如需开启，必须由数据主体显式逐次确认，并写明用途 / 接收方 / 保留期。
WEB_SEARCH_ENABLED=false
